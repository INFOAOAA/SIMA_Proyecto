        "#| label: exploracion-estadistica\n",
        "#| echo: false\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from IPython.display import display, Markdown\n",
        "\n",
        "# Carga de datos y dimensión\n",
        "df = pd.read_csv('SIMA_Diario_Imputado.csv')\n",
        "filas, columnas = df.shape\n",
        "display(Markdown(f\"**Dimensión del dataset:** \n",
        "{filas} registros y {columnas} columnas.\"))\n",
        "\n",
        "# Medidas estadísticas para variables cuantitativas\n",
        "# Tendencia central (media, mediana) y dispersión (std, min, max)\n",
        "stats_cuant = df.describe().T\n",
        "\n",
        "# Calculando Moda, Varianza y Rango manualmente\n",
        "moda = df.select_dtypes(include=[np.number]).mode().iloc[0]\n",
        "varianza = df.select_dtypes(include=[np.number]).var()\n",
        "\n",
        "stats_cuant['mediana'] = stats_cuant['50%']\n",
        "stats_cuant['moda'] = moda\n",
        "stats_cuant['varianza'] = varianza\n",
        "stats_cuant['rango'] = stats_cuant['max'] - stats_cuant['min']\n",
        "\n",
        "# Filtrar columnas solicitadas\n",
        "columnas_mostrar = ['mean', 'mediana', 'moda', 'std', 'varianza', 'rango', 'min', 'max']\n",
        "display(Markdown(\"**Estadísticas de Variables Cuantitativas:**\"))\n",
        "display(stats_cuant[columnas_mostrar].round(2))\n",
        "\n",
        "# 3. Distribución de frecuencias para variables cualitativas (Estación)\n",
        "frecuencia_estacion = df['Estacion'].value_counts().reset_index()\n",
        "frecuencia_estacion.columns = ['Estacion', 'Frecuencia']\n",
        "display(Markdown(\"**Tabla de Frecuencia (Variable Cualitativa - Estación):**\"))\n",
        "display(frecuencia_estacion)"
